<robot name="torso">
    <!-- 8-leg ant: legs evenly spaced at 0,45,90,135,180,225,270,315 degrees -->
    <!-- Leg numbering: 1=0deg(right), 2=45deg(front-right), 3=90deg(front),  -->
    <!--   4=135deg(front-left), 5=180deg(left), 6=225deg(back-left),          -->
    <!--   7=270deg(back), 8=315deg(back-right)                                -->

    <link name="torso">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rot="0.0 0.0 0.0 1.0"/>
            <mass value="-1.0"/>
